# Local development settings. Do not commit your real .env file.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1
APP_ENV=development

# MySQL connection. Run sql/schema.sql and sql/seed.sql in MySQL Workbench first.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marine_fleet_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Initial administrator created when the app starts and no matching user exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional alternative to DB_* variables; URL-encode special characters in credentials.
# DATABASE_URL=mysql+pymysql://user:percent_encoded_password@host:3306/marine_fleet_db?charset=utf8mb4
